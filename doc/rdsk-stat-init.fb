
CONNECT 'localhost:/local/firebird/rdsk_stat-1.0.fdb' USER 'rdsk' PASSWORD '****' ROLE RDB$ADMIN;

CREATE TABLE "STATISTICS" (
    "Site"          integer,
    "User"          integer,
    "HostName"      integer,
    "HostGroup"     integer,
    "Time"          timestamp
    );

CREATE TABLE "KEYS" (
    "ID"           integer NOT NULL PRIMARY KEY,
    "Key"          varchar(128)
    );

CREATE GENERATOR gen_key_id;
SET GENERATOR gen_key_id TO 1;

set term !! ;
CREATE TRIGGER KEY_TRIGGER FOR "KEYS"
ACTIVE BEFORE INSERT POSITION 0
AS
BEGIN
if (NEW.ID is NULL) then NEW.ID = GEN_ID(gen_key_id, 1);
END!!
set term ; !!

COMMIT;

